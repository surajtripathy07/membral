{
  "name": "@membral/cloud",
  "version": "0.1.0",
  "description": "Your coding agent can answer from what your past sessions found. The Membral web app and API.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/package-extension.mjs && node ../../packages/cli/scripts/pack.mjs --out public/membral-cli.tgz",
    "build": "next build",
    "start": "next start",
    "lint": "biome check ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.generated.ts",
    "db:types:check": "supabase gen types typescript --local --schema public > /tmp/database.generated.check.ts && diff -u src/lib/database.generated.ts /tmp/database.generated.check.ts",
    "code-kg:backfill": "tsx scripts/code-kg/backfill.ts",
    "flags": "tsx scripts/flags.ts",
    "memory:backfill": "tsx scripts/memory/backfill.ts",
    "memory:backfill-raw-units": "tsx scripts/memory/backfill-raw-units.ts",
    "memory:dedup": "tsx scripts/memory/dedup-semantic.ts",
    "memory:merged": "tsx scripts/memory/merged.ts",
    "memory:reconcile": "tsx scripts/memory/reconcile.ts",
    "metrics": "tsx scripts/metrics/product.ts",
    "metrics:mcp": "tsx scripts/metrics/mcp-usage.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@huggingface/transformers": "4.3.1",
    "@membral/core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "bcryptjs": "^3.0.3",
    "chrono-node": "^2.10.2",
    "fflate": "^0.8.2",
    "next": "^15.3.1",
    "openai": "^6.33.0",
    "postcss": "^8.5.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@membral/cli": "*",
    "@membral/test-kit": "*",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
