# Local-dev defaults for config.toml's env(...) substitutions (issue #12,
# hardened by issue #126 verification finding 9). Copy this to `supabase/.env`
# (gitignored, same as every other .env* file in this repo) before running
# any `npx supabase ...` command from this directory:
#
#   cp apps/cloud/supabase/.env.example apps/cloud/supabase/.env
#
# supabase/.env is loaded automatically by the Supabase CLI when running
# commands from this directory (supabase start / db reset / etc.) — NOT read
# by Next.js itself (that's apps/cloud/.env.local). The two values below are
# not secret (fixed local URLs, the same ones config.toml hard-coded before
# this change) — but supabase/.env is ALSO the canonical path Supabase's own
# docs tell you to use for env(...) substitutions of real secrets (e.g.
# `openai_api_key = "env(OPENAI_API_KEY)"` in config.toml), so this template
# is committed instead of the real file: whatever you add to your own local
# supabase/.env (a real OPENAI_API_KEY, an SMTP password, ...) stays
# gitignored, never accidentally committed.
#
# This file is intentionally NOT used for the hosted project — the hosted
# project's Site URL / Redirect URLs are a dashboard setting
# (Authentication -> URL Configuration), independent of this repo. See
# docs/DEPLOY.md.
SUPABASE_SITE_URL=http://127.0.0.1:3000
# round-3 review MED 28: was `https://` — a plaintext local dev server never
# serves https, so that redirect URL could never actually match.
SUPABASE_ADDITIONAL_REDIRECT_URL=http://127.0.0.1:3000
