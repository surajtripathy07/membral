# Supabase project the extension authenticates against.
# For local development, use the URL printed by `npx supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloud API base URL the extension pushes synced conversations to.
# Default when unset (issue #12): "npm run dev" (a --mode development build)
# defaults to http://localhost:3000; "npm run build" (production) defaults to
# https://membral.me. Set this explicitly to override either default —
# e.g. point a dev build at a hosted staging instance, or a production build
# at a self-hosted cloud.
VITE_CLOUD_URL=http://localhost:3000
