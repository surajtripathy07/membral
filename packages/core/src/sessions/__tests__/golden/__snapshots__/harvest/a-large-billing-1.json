      "idx": 62,
      "kind": "tool_use",
      "resultType": "create",
      "role": "assistant",
      "text": "const { roundCents } = require(\"./money\");\n\nfunction generateInvoices(ledgerEntries, opts = {}) {\n  const { startDate = null, endDate = null, currency = \"USD\" } = opts;\n\n  const invoices = new Map();\n\n  for (const entry of ledgerEntries) {\n    const entryDate = entry.date ? new Date(entry.date) : new Date();\n\n    if (startDate && entryDate < startDate) continue;\n    if (endDate && entryDate > endDate) continue;\n\n    const key = `${entry.accountId}`;\n    if (!invoices.has(key)) {\n      invoices.set(key, {\n        id: generateInvoiceId(entry.accountId, entryDate),\n        customer: entry.accountId,\n        date: entryDate.toLocaleDateString(\"en-US\"),\n        total: 0,\n        currency: entry.currency || currency,\n      });\n    }\n\n    const invoice = invoices.get(key);\n    invoice.total += entry.kind === \"credit\" ? entry.amount : -entry.amount;\n    invoice.total = roundCents(invoice.total);\n  }\n\n  return Array.from(invoices.values());\n}\n\nfunction generateInvoiceId(accountId, date) {\n  const year = date.getFullYear();\n  const month = String(date.getMonth() + 1).padStart(2, \"0\");\n  const hash = accountId.substring(0, 4).toUpperCase();\n  return `INV-${year}${month}-${hash}`;\n}\n\nmodule.exports = { generateInvoices, generateInvoiceId };\n",
