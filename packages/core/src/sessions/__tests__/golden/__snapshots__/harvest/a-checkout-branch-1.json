      "idx": 7,
      "kind": "tool_use",
      "role": "assistant",
      "text": "// Banker's rounding (round-half-to-even) to cents: when a value is exactly halfway\n// between two cent values, round to the nearest even cent. This minimizes rounding bias\n// in financial calculations, ensuring neither over- nor under-rounding accumulates.\nfunction roundCents(x) {\n  const n = x * 100;\n  const f = Math.floor(n);\n  const d = n - f;\n  if (Math.abs(d - 0.5) < 1e-9) return (f % 2 === 0 ? f : f + 1) / 100;\n  return Math.round(n) / 100;\n}",
