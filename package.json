{
  "name": "membral",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:vercelignore": "bash scripts/check-vercelignore.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "smoke": "node smoke/run.mjs",
    "mcp:audit": "node scripts/mcp-audit.mjs",
    "check:pure-move": "node scripts/check-pure-move.mjs",
    "check:move-coverage": "node scripts/check-move-coverage.mjs",
    "check:mock-paths": "node scripts/check-mock-paths.mjs",
    "check:ratchets": "node scripts/check-ratchets.mjs",
    "check:vercel-functions": "node scripts/check-vercel-functions.mjs",
    "check:doc-paths": "node scripts/check-doc-paths.mjs",
    "diff:run": "node scripts/diff-run.mjs",
    "coverage": "npm exec --workspaces -- vitest run --coverage",
    "ci:local": "bash scripts/ci-local.sh",
    "check:ci-local-sync": "node scripts/check-ci-local-sync.mjs"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "^3.2.4",
    "turbo": "^2.5.0"
  },
  "optionalDependencies": {
    "@biomejs/cli-linux-x64": "2.4.11",
    "@esbuild/linux-x64": "0.27.7",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "@next/swc-linux-x64-gnu": "15.5.14",
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.12",
    "@rollup/rollup-linux-x64-gnu": "4.60.1",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
